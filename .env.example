# Local-only credentials and runtime configuration for Mandate Bootstrap.
# Copy to `.env`; never commit real secrets. `.env` is ignored by Git.

# Required by GitHubPersistence. For a private Mandate repository, the token must
# have access to that repository and permission to read/write Issues and comments.
GITHUB_TOKEN=

# Optional Modelrail browser identity override. If omitted, the pinned Modelrail
# runtime uses ~/.modelrail/browser-profile. The selected profile must already be
# authenticated with ChatGPT for a ChatGPT live Bootstrap run.
# MODELRAIL_BROWSER_PROFILE_DIR="C:\\path\\to\\modelrail-browser-profile"

# Optional Modelrail browser/CDP overrides.
# MODELRAIL_BRAVE_EXE="C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
# MODELRAIL_CDP_PORT=9222
